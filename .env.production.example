# Template de produção — copie para `.env.production` NA VPS e preencha os
# valores reais. Este arquivo (.example) é o único que deve ir pro git;
# `.env.production` nunca é commitado (já coberto por `.env*` no .gitignore).
#
# `scripts/vps-setup.sh` gera boa parte disso automaticamente na primeira
# execução (DATABASE_URL com senha aleatória, BETTER_AUTH_SECRET). O que
# sobra pra preencher na mão: credenciais do Google OAuth.

# ===== Banco de dados (PostgreSQL nativo no host) =====
# O container da app roda em Docker e o Postgres roda direto no host da VPS,
# por isso usamos host.docker.internal (não "localhost") para o container
# alcançar o banco.
DATABASE_URL=postgresql://gamif_prod:CHANGE_ME@host.docker.internal:5432/gamif_evento_prod

# ===== Better-Auth =====
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
BETTER_AUTH_URL=https://gameficacao.brunogusmao.dev

# URL pública usada pelo client (precisa bater com BETTER_AUTH_URL). É
# injetada como build-arg do Docker — ver docker-compose.prod.yml.
NEXT_PUBLIC_APP_URL=https://gameficacao.brunogusmao.dev

# ===== Login social: Google =====
# Credenciais em https://console.cloud.google.com/apis/credentials
# URI de redirecionamento a cadastrar lá:
#   https://gameficacao.brunogusmao.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# ===== Admin inicial (seed) =====
# Troque para credenciais fortes antes de rodar `pnpm db:seed` em produção —
# não use os valores de exemplo do ambiente de dev.
ADMIN_EMAIL=CHANGE_ME_admin_email
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_EMAIL_2=CHANGE_ME_admin2_email
ADMIN_PASSWORD_2=CHANGE_ME_strong_password_2

# ===== Notificações push (Web Push / VAPID) =====
# Gere um par com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY precisa ser igual a VAPID_PUBLIC_KEY — é
# injetada como build-arg do Docker (ver docker-compose.prod.yml), assim
# como NEXT_PUBLIC_APP_URL acima.
VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key
VAPID_SUBJECT=mailto:CHANGE_ME@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
