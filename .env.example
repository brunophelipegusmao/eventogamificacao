# ===== Banco de dados (PostgreSQL) =====
DATABASE_URL=postgresql://gamif:gamif_dev_password@localhost:5432/gamif_evento

# ===== Better-Auth =====
# Segredo usado para assinar sessões/JWT. Gere um com: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# URL pública da aplicação (em produção, o domínio real)
BETTER_AUTH_URL=http://localhost:3000

# ===== Login social: Google =====
# Criar credenciais em https://console.cloud.google.com/apis/credentials
# URIs de redirecionamento: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# ===== Admin inicial (seed) =====
ADMIN_EMAIL=admin@julianamartinsfitness.store
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL_2=admin2@julianamartinsfitness.store
ADMIN_PASSWORD_2=Admin2@123456
